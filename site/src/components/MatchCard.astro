---
import { leagueName, pct, slug, topDrivers } from "../lib/format.mjs";
const { fixture: f } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const drivers = topDrivers(f.drivers, 3);
---
<article class="card" data-match={f.match_id}>
  <p class="when">{f.date}, {leagueName(f.league)}</p>
  <h3><a href={`${base}/match/${slug(f.match_id)}/`}>{f.home} v {f.away}</a></h3>
  <div class="bar" role="img" aria-label={`${f.home} ${pct(f.p_home)}, draw ${pct(f.p_draw)}, ${f.away} ${pct(f.p_away)}`}>
    <span class="h" style={`flex:${f.p_home}`}></span>
    <span class="d" style={`flex:${f.p_draw}`}></span>
    <span class="a" style={`flex:${f.p_away}`}></span>
  </div>
  <ul class="odds">
    <li><b>{pct(f.p_home)}</b> {f.home}</li>
    <li><b>{pct(f.p_draw)}</b> Draw</li>
    <li><b>{pct(f.p_away)}</b> {f.away}</li>
  </ul>
  {drivers.length > 0 && (
    <ul class="why">
      {drivers.map((d) => <li data-driver>{d.text}</li>)}
    </ul>
  )}
</article>
<style>
  .card { border-top: 2px solid var(--ink); padding: 14px 0 18px; }
  .when { margin: 0; color: var(--muted); font-size: 0.85rem; }
  h3 { margin: 2px 0 10px; font-size: 1.15rem; }
  .bar { display: flex; height: 14px; gap: 2px; border: 0; padding: 0; }
  .bar span { display: block; min-width: 4px; }
  .h { background: var(--home); } .d { background: var(--draw); } .a { background: var(--away); }
  .odds { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .odds b { font-variant-numeric: tabular-nums; }
  .why { margin: 8px 0 0; padding-left: 18px; color: var(--muted); font-size: 0.92rem; }
</style>
