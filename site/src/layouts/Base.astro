---
import StalenessBanner from "../components/StalenessBanner.astro";
import { meta, now } from "../lib/data.mjs";
import { formatUpdated } from "../lib/format.mjs";
const { title, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  { href: `${base}/`, label: "Fixtures", match: (p) => p === "/" || p.startsWith("/match") },
  { href: `${base}/teams/`, label: "Teams", match: (p) => p.startsWith("/teams") || p.startsWith("/team/") },
  { href: `${base}/track-record/`, label: "Track record", match: (p) => p.startsWith("/track-record") },
  { href: `${base}/about/`, label: "How it works", match: (p) => p.startsWith("/about") },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Match odds</title>
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <a class="skip" href="#main">Skip to content</a>
    <StalenessBanner updatedAt={meta.updated_at} now={now.toISOString()} />
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={`${base}/`}>
          <svg class="logo" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M12 6.5l4.2 3-1.6 5h-5.2l-1.6-5z" fill="currentColor" />
          </svg>
          <span>Match odds</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.match(path) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <button type="button" class="theme" id="theme-toggle" aria-label="Switch between light and dark theme">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M21 13.5A9 9 0 1 1 10.5 3a7 7 0 0 0 10.5 10.5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class={wide ? "wide" : undefined}><slot /></main>
    <footer>
      <p>Last updated {formatUpdated(meta.updated_at)}. Model {meta.model_version}. Made for fans, not for betting.</p>
    </footer>
    <script>
      let spotlight = null;
      document.addEventListener("pointermove", (e) => {
        const t = e.target instanceof Element ? e.target.closest(".card, .glow") : null;
        if (!t) return;
        const x = e.clientX, y = e.clientY;
        if (spotlight) cancelAnimationFrame(spotlight);
        spotlight = requestAnimationFrame(() => {
          const r = t.getBoundingClientRect();
          t.style.setProperty("--mx", `${x - r.left}px`);
          t.style.setProperty("--my", `${y - r.top}px`);
        });
      }, { passive: true });
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === "dark" ||
          (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
    <style is:global>
      :root {
        --paper: #eaf3ee; --surface: rgb(255 255 255 / 0.58); --field: rgb(255 255 255 / 0.7); --ink: #10201a; --muted: #43544a; --line: rgb(255 255 255 / 0.65);
        --edge: rgb(16 32 26 / 0.45); --rule: rgb(16 32 26 / 0.2); --on-warn: #ffffff; --orb1: rgb(70 200 140 / 0.5); --orb2: rgb(80 120 240 / 0.42); --orb3: rgb(245 190 80 / 0.4); --glass-blur: blur(18px) saturate(170%);
        --mesh: radial-gradient(60rem 40rem at 8% -10%, rgb(95 207 151 / 0.45), transparent 60%),
          radial-gradient(50rem 36rem at 100% 0%, rgb(86 130 230 / 0.38), transparent 60%),
          radial-gradient(46rem 34rem at 60% 110%, rgb(240 190 90 / 0.34), transparent 60%);
        --brand: #17623d; --focus: #b87500;
        --home: #1b6b43; --on-home: #ffffff;
        --draw: #e3b04b; --on-draw: #2b1d00;
        --away: #3556a0; --on-away: #ffffff;
        --warn: #8a2d1f; --shadow: 0 8px 30px rgb(19 34 26 / 0.1), inset 0 1px 0 rgb(255 255 255 / 0.8);
        --good: #17623d; --lean: #8a5a00; --toss: #4b5b51;
        --radius: 18px;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #07100c; --surface: rgb(255 255 255 / 0.07); --field: rgb(255 255 255 / 0.09); --ink: #eef5f0; --muted: #b3c4b8; --line: rgb(255 255 255 / 0.14);
          --edge: rgb(255 255 255 / 0.45); --rule: rgb(255 255 255 / 0.2); --on-warn: #1f0700; --orb1: rgb(40 170 110 / 0.5); --orb2: rgb(70 100 230 / 0.34); --orb3: rgb(224 150 50 / 0.22);
          --mesh: radial-gradient(60rem 40rem at 8% -10%, rgb(63 174 119 / 0.38), transparent 60%),
            radial-gradient(50rem 36rem at 100% 0%, rgb(86 120 220 / 0.34), transparent 60%),
            radial-gradient(46rem 34rem at 60% 110%, rgb(224 176 74 / 0.2), transparent 60%);
          --brand: #5fcf97; --focus: #f0c060;
          --home: #3fae77; --on-home: #06150d;
          --draw: #e0b04a; --on-draw: #241900;
          --away: #86a2e6; --on-away: #0b1430;
          --shadow: 0 8px 32px rgb(0 0 0 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.08); --good: #6ad9a0; --lean: #f0c060; --toss: #b3c4b8; --warn: #ff9b86;
        }
      }
      :root[data-theme="dark"] {
        --paper: #07100c; --surface: rgb(255 255 255 / 0.07); --field: rgb(255 255 255 / 0.09); --ink: #eef5f0; --muted: #b3c4b8; --line: rgb(255 255 255 / 0.14);
        --edge: rgb(255 255 255 / 0.45); --rule: rgb(255 255 255 / 0.2); --on-warn: #1f0700; --orb1: rgb(40 170 110 / 0.5); --orb2: rgb(70 100 230 / 0.34); --orb3: rgb(224 150 50 / 0.22);
        --mesh: radial-gradient(60rem 40rem at 8% -10%, rgb(63 174 119 / 0.38), transparent 60%),
          radial-gradient(50rem 36rem at 100% 0%, rgb(86 120 220 / 0.34), transparent 60%),
          radial-gradient(46rem 34rem at 60% 110%, rgb(224 176 74 / 0.2), transparent 60%);
        --brand: #5fcf97; --focus: #f0c060;
        --home: #3fae77; --on-home: #06150d;
        --draw: #e0b04a; --on-draw: #241900;
        --away: #86a2e6; --on-away: #0b1430;
        --shadow: 0 8px 32px rgb(0 0 0 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.08); --good: #6ad9a0; --lean: #f0c060; --toss: #b3c4b8; --warn: #ff9b86;
      }
      * { box-sizing: border-box; }
      .aurora { position: fixed; inset: 0; overflow: hidden; z-index: -1; pointer-events: none; }
      .aurora i { position: absolute; width: 44rem; height: 44rem; border-radius: 50%; filter: blur(80px); }
      @media (hover: hover) and (pointer: fine) { .aurora i { will-change: transform; animation: drift 32s ease-in-out infinite alternate; } }
      .aurora i:nth-child(1) { background: var(--orb1); top: -16rem; left: -12rem; }
      .aurora i:nth-child(2) { background: var(--orb2); top: -10rem; right: -16rem; animation-duration: 40s; animation-delay: -9s; }
      .aurora i:nth-child(3) { background: var(--orb3); bottom: -20rem; left: 30%; animation-duration: 46s; animation-delay: -18s; }
      @keyframes drift { to { transform: translate3d(6rem, 4rem, 0) scale(1.12); } }
      @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
      .glow { position: relative; }
      .glow:hover { background-image: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.16), transparent 60%); }
      html { color-scheme: light dark; }
      body { margin: 0; background-color: var(--paper); background-image: var(--mesh); background-attachment: fixed; color: var(--ink); min-height: 100vh;
        font: 17px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-text-size-adjust: 100%; }
      a { color: var(--brand); }
      :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
      .skip { position: absolute; left: 8px; top: -60px; background: var(--paper); color: var(--ink);
        padding: 10px 14px; border-radius: 8px; z-index: 50; }
      .skip:focus { top: 8px; }
      .topbar { background: var(--surface); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border-bottom: 1px solid var(--line); box-shadow: 0 1px 0 var(--edge); position: sticky; top: 0; z-index: 20; }
      .topbar-inner { max-width: 60rem; margin: 0 auto; padding: 8px 16px; display: flex; align-items: center; gap: 8px 20px; flex-wrap: wrap; }
      .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 1.2rem; color: var(--ink);
        text-decoration: none; letter-spacing: -0.01em; min-height: 44px; }
      .logo { color: var(--brand); }
      nav { display: flex; gap: 4px; flex-wrap: wrap; flex: 1; }
      nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px;
        color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.97rem; }
      nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--line) 55%, transparent); }
      nav a[aria-current="page"] { color: var(--on-home); background: var(--home); }
      .theme { width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--edge); background: transparent;
        color: var(--ink); display: inline-grid; place-items: center; cursor: pointer; margin-left: auto; }
      .theme:hover { background: color-mix(in srgb, var(--line) 55%, transparent); }
      main, footer { max-width: 60rem; margin: 0 auto; padding: 0 16px; }
      h1 { font-size: clamp(2rem, 6.5vw, 3.2rem); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; margin: 32px 0 10px;
        background: linear-gradient(100deg, var(--ink) 30%, var(--brand)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      h2 { font-size: 1.25rem; margin: 32px 0 10px; letter-spacing: -0.01em; }
      p, li { max-width: 62ch; }
      .lede { color: var(--muted); margin: 0 0 18px; }
      footer { color: var(--muted); padding-top: 28px; padding-bottom: 44px; font-size: 0.9rem; }
      table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
      th, td { text-align: left; padding: 10px 8px 10px 0; border-bottom: 1px solid var(--rule); }
      .field { display: grid; gap: 4px; }
      .lab { font-size: 0.8rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
      .field input, .field select { min-height: 44px; border: 1px solid var(--edge); border-radius: 10px; padding: 0 12px;
        background: var(--field); color: var(--ink); font: inherit; width: 100%; }
      .check { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 600; cursor: pointer; }
      .check input { width: 22px; height: 22px; accent-color: var(--home); }
      .count { margin: 0; color: var(--muted); font-weight: 600; font-variant-numeric: tabular-nums; }
      [hidden] { display: none !important; }
      @media (max-width: 640px) {
        .topbar-inner { gap: 0 12px; }
        nav { order: 3; flex: 1 0 100%; flex-wrap: nowrap; overflow-x: auto; margin: 0 -8px; padding: 0 8px 6px; scrollbar-width: none; }
        nav a { white-space: nowrap; }
      }
      .panel { background: var(--surface); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1px solid var(--line);
        border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 18px; }
      @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        :root { --surface: #ffffff; --field: #ffffff; --line: #d6ded7; }
        @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --surface: #15211b; --field: #15211b; --line: #27382d; } }
        :root[data-theme="dark"] { --surface: #15211b; --field: #15211b; --line: #27382d; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
    </style>
  </body>
</html>
