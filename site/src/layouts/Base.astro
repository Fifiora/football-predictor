---
import StalenessBanner from "../components/StalenessBanner.astro";
import { meta, now } from "../lib/data.mjs";
import { formatUpdated } from "../lib/format.mjs";
const { title, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const icons = {
  fix: `<path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`, rec: `<path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`, bank: `<path d="M3 8h18v11H3zM3 8l2-4h14l2 4M16 13.5h2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`, teams: `<path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 19c0-3 2.7-5 6-5s6 2 6 5M16 6a3 3 0 0 1 0 5.5M18 14c1.8.6 3 2.2 3 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`, about: `<path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v5M12 8h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
};
const nav = [
  { href: `${base}/`, label: "Fixtures", icon: "fix", match: (p) => p === "/" || p.startsWith("/match") },
  { href: `${base}/track-record/`, label: "Record", full: "Track record", icon: "rec", match: (p) => p.startsWith("/track-record") },
  { href: `${base}/bankroll/`, label: "Bankroll", icon: "bank", match: (p) => p.startsWith("/bankroll") },
  { href: `${base}/teams/`, label: "Teams", icon: "teams", match: (p) => p.startsWith("/teams") || p.startsWith("/team/") },
  { href: `${base}/about/`, label: "About", icon: "about", match: (p) => p.startsWith("/about") },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Match odds</title>
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <a class="skip" href="#main">Skip to content</a>
    <StalenessBanner updatedAt={meta.updated_at} now={now.toISOString()} />
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={`${base}/`}>
          <svg class="logo" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M12 6.5l4.2 3-1.6 5h-5.2l-1.6-5z" fill="currentColor" />
          </svg>
          <span>Match odds</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.match(path) ? "page" : undefined} aria-label={n.full ?? undefined}>
              <svg class="ico" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" set:html={icons[n.icon]} />
              <span>{n.label}</span>
            </a>
          ))}
        </nav>
        <button type="button" class="theme" id="theme-toggle" aria-label="Switch between light and dark theme">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M21 13.5A9 9 0 1 1 10.5 3a7 7 0 0 0 10.5 10.5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class={wide ? "wide" : undefined}><slot /></main>
    <footer>
      <p>Last updated {formatUpdated(meta.updated_at)}. Model {meta.model_version}. Made for fans, not for betting.</p>
    </footer>
    <script>
      import { formatDay, localParts } from "../lib/format.mjs";
      document.querySelectorAll("time[data-kickoff]").forEach((el) => {
        const p = localParts(el.getAttribute("data-kickoff"));
        if (p) { el.textContent = `${p.time} ${p.zone}`.trim(); el.title = "Shown in your timezone";
          const day = el.parentElement?.querySelector("time.day");
          if (day) day.textContent = formatDay(p.date); }
      });
      let spotlight = null;
      document.addEventListener("pointermove", (e) => {
        const t = e.target instanceof Element ? e.target.closest(".card, .glow") : null;
        if (!t) return;
        const x = e.clientX, y = e.clientY;
        if (spotlight) cancelAnimationFrame(spotlight);
        spotlight = requestAnimationFrame(() => {
          const r = t.getBoundingClientRect();
          t.style.setProperty("--mx", `${x - r.left}px`);
          t.style.setProperty("--my", `${y - r.top}px`);
        });
      }, { passive: true });
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === "dark" ||
          (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
    <style is:global>
      /* PharmAnalytics look: navy and electric cyan, milky glass by day, navy-tinted glass by night. Green and coral mean gain and loss only. */
      :root {
        --paper: #fafafb; --surface: rgb(255 255 255 / 0.56); --field: rgb(255 255 255 / 0.72); --ink: #0a0a14; --muted: #55556a; --line: rgb(0 0 60 / 0.1);
        --edge: rgb(0 0 60 / 0.4); --rule: rgb(0 0 92 / 0.14); --on-warn: #ffffff; --orb1: rgb(0 191 255 / 0.38); --orb2: rgb(61 123 255 / 0.3); --orb3: rgb(0 0 128 / 0.12); --glass-blur: blur(28px) saturate(1.75);
        --mesh: radial-gradient(70% 46% at 12% -4%, rgb(0 0 128 / 0.07), transparent 70%),
          radial-gradient(52% 38% at 96% 6%, rgb(0 0 92 / 0.06), transparent 72%),
          radial-gradient(60% 40% at 70% 108%, rgb(0 191 255 / 0.12), transparent 70%);
        --brand: #000080; --focus: #006a96;
        --home: #000080; --on-home: #ffffff;
        --draw: #8fdcf7; --on-draw: #00005c;
        --away: #1a66cc; --on-away: #ffffff;
        --warn: #a8221b; --shadow: 0 1px 1px rgb(0 0 80 / 0.05), 0 6px 16px -8px rgb(0 0 80 / 0.14), 0 24px 48px -28px rgb(0 0 80 / 0.28), inset 0 1px 0 rgb(255 255 255 / 0.9);
        --good: #0b6342; --lean: #8a4b00; --toss: #55556a;
        --rim1: rgb(255 255 255 / 0.95); --rim2: rgb(255 255 255 / 0.35); --rim3: rgb(0 150 220 / 0.28); --gloss: rgb(255 255 255 / 0.5);
        --font-head: ui-rounded, Nunito, "SF Pro Rounded", system-ui, -apple-system, "Segoe UI", sans-serif; --font-label: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
        --radius: 20px;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #06060f; --surface: rgb(12 12 48 / 0.5); --field: rgb(255 255 255 / 0.09); --ink: #ffffff; --muted: #a9acc9; --line: rgb(160 190 255 / 0.14);
          --edge: rgb(255 255 255 / 0.45); --rule: rgb(255 255 255 / 0.2); --on-warn: #1f0700; --orb1: rgb(0 191 255 / 0.3); --orb2: rgb(61 123 255 / 0.38); --orb3: rgb(0 0 128 / 0.55);
          --mesh: radial-gradient(70% 46% at 12% -4%, rgb(0 0 160 / 0.4), transparent 70%),
            radial-gradient(52% 38% at 96% 6%, rgb(0 0 92 / 0.5), transparent 72%),
            radial-gradient(60% 40% at 70% 108%, rgb(0 191 255 / 0.08), transparent 70%);
          --brand: #33ccff; --focus: #00bfff;
          --home: #00bfff; --on-home: #00005c;
          --draw: #b4b7ff; --on-draw: #12124a;
          --away: #5f8cff; --on-away: #00103a;
          --shadow: 0 1px 1px rgb(0 0 20 / 0.5), 0 8px 20px -10px rgb(0 0 20 / 0.7), 0 28px 56px -28px rgb(0 0 20 / 0.9), inset 0 1px 0 rgb(160 190 255 / 0.14);
          --good: #5fd39d; --lean: #ffb547; --toss: #a9acc9; --warn: #ff8f86;
          --rim1: rgb(150 225 255 / 0.6); --rim2: rgb(255 255 255 / 0.12); --rim3: rgb(0 191 255 / 0.12); --gloss: rgb(255 255 255 / 0.07);
        }
      }
      :root[data-theme="dark"] {
        --paper: #06060f; --surface: rgb(12 12 48 / 0.5); --field: rgb(255 255 255 / 0.09); --ink: #ffffff; --muted: #a9acc9; --line: rgb(160 190 255 / 0.14);
        --edge: rgb(255 255 255 / 0.45); --rule: rgb(255 255 255 / 0.2); --on-warn: #1f0700; --orb1: rgb(0 191 255 / 0.3); --orb2: rgb(61 123 255 / 0.38); --orb3: rgb(0 0 128 / 0.55);
        --mesh: radial-gradient(70% 46% at 12% -4%, rgb(0 0 160 / 0.4), transparent 70%),
          radial-gradient(52% 38% at 96% 6%, rgb(0 0 92 / 0.5), transparent 72%),
          radial-gradient(60% 40% at 70% 108%, rgb(0 191 255 / 0.08), transparent 70%);
        --brand: #33ccff; --focus: #00bfff;
        --home: #00bfff; --on-home: #00005c;
        --draw: #b4b7ff; --on-draw: #12124a;
        --away: #5f8cff; --on-away: #00103a;
        --shadow: 0 1px 1px rgb(0 0 20 / 0.5), 0 8px 20px -10px rgb(0 0 20 / 0.7), 0 28px 56px -28px rgb(0 0 20 / 0.9), inset 0 1px 0 rgb(160 190 255 / 0.14);
        --good: #5fd39d; --lean: #ffb547; --toss: #a9acc9; --warn: #ff8f86;
        --rim1: rgb(150 225 255 / 0.6); --rim2: rgb(255 255 255 / 0.12); --rim3: rgb(0 191 255 / 0.12); --gloss: rgb(255 255 255 / 0.07);
      }
      * { box-sizing: border-box; }
      .aurora { position: fixed; inset: 0; overflow: hidden; z-index: -1; pointer-events: none; }
      .aurora i { position: absolute; width: 44rem; height: 44rem; border-radius: 50%; filter: blur(80px); }
      @media (hover: hover) and (pointer: fine) { .aurora i { will-change: transform; animation: drift 32s ease-in-out infinite alternate; } }
      .aurora i:nth-child(1) { background: var(--orb1); top: -16rem; left: -12rem; }
      .aurora i:nth-child(2) { background: var(--orb2); top: -10rem; right: -16rem; animation-duration: 40s; animation-delay: -9s; }
      .aurora i:nth-child(3) { background: var(--orb3); bottom: -20rem; left: 30%; animation-duration: 46s; animation-delay: -18s; }
      @keyframes drift { to { transform: translate3d(6rem, 4rem, 0) scale(1.12); } }
      @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
      .glow { position: relative; }
      .glow:hover { background-image: radial-gradient(22rem circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.16), transparent 60%); }
      html { color-scheme: light dark; }
      body { margin: 0; background-color: var(--paper); background-image: var(--mesh); background-attachment: fixed; color: var(--ink); min-height: 100vh;
        font: 17px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-text-size-adjust: 100%; }
      a { color: var(--brand); }
      :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
      .skip { position: absolute; left: 8px; top: -60px; background: var(--paper); color: var(--ink);
        padding: 10px 14px; border-radius: 8px; z-index: 50; }
      .skip:focus { top: 8px; }
      .topbar { background: var(--surface); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border-bottom: 1px solid var(--line); box-shadow: 0 1px 0 var(--edge); position: sticky; top: 0; z-index: 20; }
      .topbar-inner { max-width: 60rem; margin: 0 auto; padding: 8px 16px; display: flex; align-items: center; gap: 8px 20px; flex-wrap: wrap; }
      .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 1.2rem; color: var(--ink);
        text-decoration: none; letter-spacing: -0.01em; min-height: 44px; }
      .logo { color: #00bfff; background: linear-gradient(160deg, #00005c, #000080 55%, #00005c); border-radius: 9px; padding: 3px; box-sizing: content-box; box-shadow: inset 0 0 0 1px rgb(0 191 255 / 0.3), 0 4px 10px -4px rgb(0 0 80 / 0.6); }
      nav { display: flex; gap: 4px; flex-wrap: wrap; flex: 1; }
      nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px;
        color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.97rem; }
      nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--line) 55%, transparent); }
      nav a[aria-current="page"] { color: var(--on-home); background: var(--home); }
      .theme { width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--edge); background: transparent;
        color: var(--ink); display: inline-grid; place-items: center; cursor: pointer; margin-left: auto; }
      .theme:hover { background: color-mix(in srgb, var(--line) 55%, transparent); }
      main, footer { max-width: 60rem; margin: 0 auto; padding: 0 16px; }
      h1 { font-size: clamp(2rem, 6.5vw, 3.2rem); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; margin: 32px 0 10px;
        background: linear-gradient(100deg, var(--ink) 30%, var(--brand)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      h1, h2, .balance, .brand { font-family: var(--font-head); }
      .lab, .k, .eyebrow { font-family: var(--font-label); }
      h2 { font-size: 1.25rem; margin: 32px 0 10px; letter-spacing: -0.01em; }
      p, li { max-width: 62ch; }
      .lede { color: var(--muted); margin: 0 0 18px; }
      footer { color: var(--muted); padding-top: 28px; padding-bottom: 44px; font-size: 0.9rem; }
      table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
      th, td { text-align: left; padding: 10px 8px 10px 0; border-bottom: 1px solid var(--rule); }
      .field { display: grid; gap: 4px; }
      .lab { font-size: 0.8rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
      .field input, .field select { min-height: 44px; border: 1px solid var(--edge); border-radius: 10px; padding: 0 12px;
        background: var(--field); color: var(--ink); font: inherit; width: 100%; }
      .check { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 600; cursor: pointer; }
      .check input { width: 22px; height: 22px; accent-color: var(--home); }
      .count { margin: 0; color: var(--muted); font-weight: 600; font-variant-numeric: tabular-nums; }
      [hidden] { display: none !important; }
      nav a .ico { display: none; }
      @media (max-width: 640px) {
        /* a blurred ancestor would trap the fixed tab bar inside the header, so the header goes plain here */
        .topbar { -webkit-backdrop-filter: none; backdrop-filter: none; background: color-mix(in srgb, var(--paper) 90%, transparent); }
        .topbar-inner { gap: 0 12px; }
        /* the main sections become a thumb-reach tab bar; five items at most, each with an icon and a label */
        nav { position: fixed; left: 12px; right: 12px; bottom: calc(10px + env(safe-area-inset-bottom)); z-index: 30; flex: none; flex-wrap: nowrap; gap: 0; justify-content: space-around;
          padding: 4px; border-radius: 24px; background: linear-gradient(180deg, var(--gloss), transparent 60%), var(--surface); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
          border: 1px solid var(--line); box-shadow: 0 12px 32px -12px rgb(0 0 80 / 0.5), inset 0 1px 0 var(--rim1); }
        nav a { flex: 1 1 0; min-width: 0; flex-direction: column; justify-content: center; gap: 2px; min-height: 52px; padding: 4px 2px; border-radius: 20px;
          font-size: 0.72rem; line-height: 1.1; text-align: center; }
        nav a .ico { display: block; }
        nav a[aria-current="page"] { background: color-mix(in srgb, var(--home) 18%, transparent); color: var(--brand); }
        main { padding-bottom: calc(92px + env(safe-area-inset-bottom)); }
        footer { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
      }
      .panel, .card { position: relative; isolation: isolate; }
      .panel::after, .card::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; padding: 1px;
        background: linear-gradient(135deg, var(--rim1), var(--rim2) 40%, var(--rim3)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
        mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
      .panel { background: var(--surface); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1px solid var(--line);
        border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 18px; }
      @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        :root { --surface: #ffffff; --field: #ffffff; --line: #d6d8e6; }
        @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --surface: #12123a; --field: #12123a; --line: #2a2a5a; } }
        :root[data-theme="dark"] { --surface: #12123a; --field: #12123a; --line: #2a2a5a; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
    </style>
  </body>
</html>
