---
import Base from "../../layouts/Base.astro";
import MatchCard from "../../components/MatchCard.astro";
import { fixtures, teams } from "../../lib/data.mjs";
import { pct, slug, topDrivers } from "../../lib/format.mjs";
export function getStaticPaths() {
  return fixtures.map((f) => ({ params: { id: slug(f.match_id) }, props: { f } }));
}
const { f } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const drivers = topDrivers(f.drivers, 3);
const maxStrength = Math.max(...drivers.map((d) => d.strength), 1e-9);
const lines = f.top_scorelines ?? [];
const maxLine = Math.max(...lines.map((s) => s.p), 1e-9);
const hasGoals = f.btts !== undefined;
const links = [f.home, f.away].filter((t) => t in teams);
---
<Base title={`${f.home} v ${f.away}`}>
  <p class="crumb"><a href={`${base}/`}>&larr; All fixtures</a></p>
  <h1>{f.home} v {f.away}</h1>
  <div class="match-card"><MatchCard fixture={f} /></div>

  {hasGoals && (
    <section class="panel block">
      <h2>Goals</h2>
      <div class="meters">
        <div class="meter">
          <div class="meter-top"><span>Both teams score</span><b>{pct(f.btts)}</b></div>
          <div class="track" aria-hidden="true"><span style={`width:${Math.round(f.btts * 100)}%`}></span></div>
        </div>
        <div class="meter">
          <div class="meter-top"><span>Over 2.5 goals</span><b>{pct(f.over_2_5)}</b></div>
          <div class="track" aria-hidden="true"><span style={`width:${Math.round(f.over_2_5 * 100)}%`}></span></div>
        </div>
      </div>
      {lines.length > 0 && (
        <>
          <h3 class="sub">Most likely scores</h3>
          <table class="scores">
            <thead><tr><th>Score</th><th class="barcell"><span class="sr">Chance as a bar</span></th><th>Chance</th></tr></thead>
            <tbody>
              {lines.map((s) => (
                <tr>
                  <td class="score">{s.score}</td>
                  <td class="barcell"><div class="track" aria-hidden="true"><span style={`width:${Math.round((s.p / maxLine) * 100)}%`}></span></div></td>
                  <td>{pct(s.p)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}
    </section>
  )}

  <section class="panel block">
    <h2>What the model weighed</h2>
    {drivers.length === 0
      ? <p>No single factor stood out for this match.</p>
      : <ul class="drivers">
          {drivers.map((d) => (
            <li>
              <span>{d.text}</span>
              <span class="track small" aria-hidden="true"><span style={`width:${Math.max(8, Math.round((d.strength / maxStrength) * 100))}%`}></span></span>
            </li>
          ))}
        </ul>}
    <p class="note">The bars show how much attention each factor got, relative to the strongest. They describe what the model paid attention to. They are not proof of why a team will win.</p>
  </section>

  {links.length > 0 && (
    <p class="teamlinks">
      {links.map((t) => <a class="btn" href={`${base}/team/${slug(t)}/`}>{t}: ratings and fixtures</a>)}
    </p>
  )}
</Base>
<style>
  .crumb { margin: 18px 0 0; }
  .crumb a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: none; }
  .match-card { margin: 8px 0 18px; max-width: 40rem; }
  .block { margin: 0 0 16px; max-width: 40rem; }
  .block h2 { margin-top: 0; }
  .sub { margin: 20px 0 6px; font-size: 1rem; }
  .meters { display: grid; gap: 14px; }
  .meter-top { display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 4px; }
  .meter-top b { font-variant-numeric: tabular-nums; }
  .track { height: 10px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .track.small { display: block; height: 6px; margin-top: 6px; }
  .track span { display: block; height: 100%; background: var(--home); border-radius: 999px; }
  .scores td, .scores th { border-bottom: 1px solid var(--line); padding: 8px 8px 8px 0; }
  .scores .barcell { width: 55%; }
  .score { font-weight: 700; font-variant-numeric: tabular-nums; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .drivers { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .drivers li { max-width: none; }
  .note { color: var(--muted); font-size: 0.9rem; margin-bottom: 0; }
  .teamlinks { display: flex; flex-wrap: wrap; gap: 10px; max-width: none; }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line);
    background: var(--surface); color: var(--ink); font-weight: 600; text-decoration: none; }
  .btn:hover { border-color: var(--brand); }
</style>
