---
import Base from "../layouts/Base.astro";
import { trackRecord as t } from "../lib/data.mjs";
import { leagueName, pct, verdictText } from "../lib/format.mjs";
import { accuracyByTier } from "../lib/filters.mjs";
const f = (x) => (x == null ? "n/a" : x.toFixed(3));
const graded = t.n_graded > 0;
const cal = graded ? t.calibration : [];
const maxN = Math.max(...cal.map((c) => c.n), 1);
// Chart geometry: 0-100% on both axes inside a 300x300 plot with a margin for labels.
const S = 300, ML = 62, MR = 16, MT = 16, MB = 46;
const x = (p) => ML + p * S;
const y = (p) => MT + (1 - p) * S;
const ticks = [0, 0.25, 0.5, 0.75, 1];
const bench = t.benchmark?.holdout ?? t.benchmark?.development ?? null;
const benchLabel = t.benchmark?.holdout ? `the ${t.benchmark.holdout_season ?? "latest"} season, played after the model was built` : "past seasons";
const gap = bench ? (bench.bookmaker.accuracy - bench.model.accuracy) * 100 : 0;
const rows = bench ? [
  { name: "Right result", note: "higher is better", m: bench.model.accuracy, b: bench.bookmaker.accuracy, show: pct, width: (x) => x },
  { name: "Log loss", note: "lower is better", m: bench.model.log_loss, b: bench.bookmaker.log_loss, show: (x) => x.toFixed(3), width: (x) => Math.min(1, x / 1.1) },
] : [];
const leagues = graded ? Object.entries(t.by_league) : [];
const picks = graded ? (t.picks ?? []) : [];
const tiers = [["all", "All picks", ""], ["confident", "Confident", "55% or more"], ["lean", "Lean", "45% to 55%"], ["toss-up", "Toss-up", "under 45%"]];
const tally = accuracyByTier(picks);
---
<Base title="Track record">
  <h1>How the predictions have done</h1>
  {!graded
    ? <section class="panel empty">
        <h2>No matches graded yet</h2>
        <p>Every prediction is saved before kickoff and is never edited afterwards. Results appear here after the first predicted matches finish: how often the top pick was right, and whether a "60%" really happens about 60% of the time.</p>
      </section>
    : <>
      <p class="lede">{t.n_graded} predicted matches graded. Every prediction was logged before kickoff and is never edited afterwards.</p>
      <div class="tiles">
        <div class="panel tile"><span class="k">Right result</span><b>{pct(t.accuracy)}</b><span class="d">How often the most likely outcome happened. Always picking the home team gets about 44%.</span></div>
        <div class="panel tile"><span class="k">Matches graded</span><b>{t.n_graded}</b><span class="d">Only matches predicted before kickoff count.</span></div>
        <div class="panel tile"><span class="k">Log loss</span><b>{f(t.log_loss)}</b><span class="d">Lower is better. A model with no skill scores about 1.07.</span></div>
        <div class="panel tile"><span class="k">Ranked score</span><b>{f(t.rps)}</b><span class="d">Lower is better. Counts a near miss as better than a far miss.</span></div>
      </div>

      {picks.length > 0 && (
        <section class="panel conf" aria-labelledby="conf-title" data-confidence>
          <h2 id="conf-title">How accurate is it when it is sure?</h2>
          <p class="sub">Every pick has a chance attached. Choose how sure the model was, and a league, to see how often those picks were right.</p>
          <div class="group" role="group" aria-label="How sure the model was">
            <span class="lab">How sure</span>
            <div class="chips">
              {tiers.map(([id, label, hint]) => (
                <button type="button" class="chip" data-tier={id} aria-pressed={id === "all" ? "true" : "false"}>{label}{hint && <span class="hint"> {hint}</span>}</button>
              ))}
            </div>
          </div>
          <div class="group" role="group" aria-label="League">
            <span class="lab">League</span>
            <div class="chips">
              <button type="button" class="chip" data-lg="" aria-pressed="true">All</button>
              {leagues.map(([l]) => <button type="button" class="chip" data-lg={l} aria-pressed="false">{leagueName(l)}</button>)}
            </div>
          </div>
          <div class="result" role="status" aria-live="polite">
            <p class="big"><b id="conf-pct">{tally.all.accuracy == null ? "n/a" : pct(tally.all.accuracy)}</b> <span id="conf-of">right: {tally.all.right} of {tally.all.n} picks</span></p>
            <div class="track" aria-hidden="true"><span id="conf-bar" style={`width:${Math.round((tally.all.accuracy ?? 0) * 100)}%`}></span></div>
            <p class="note" id="conf-said">The model gave these picks {tally.all.said == null ? "n/a" : pct(tally.all.said)} on average.</p>
            <p class="note" id="conf-small" hidden>Only a few picks so far, so treat this as a rough guide.</p>
          </div>
          <table class="tiers">
            <thead><tr><th>How sure</th><th>Picks</th><th>Right</th></tr></thead>
            <tbody>
              {tiers.slice(1).map(([id, label, hint]) => (
                <tr data-row={id}><td>{label} <span class="hint">{hint}</span></td><td data-n>{tally[id].n}</td><td data-acc>{tally[id].accuracy == null ? "n/a" : pct(tally[id].accuracy)}</td></tr>
              ))}
            </tbody>
          </table>
          <script id="picks-data" type="application/json" is:inline set:html={JSON.stringify(picks)}></script>
        </section>
      )}

      <h2>Are the percentages honest?</h2>
      <p>When the model says 30%, that should happen about 30% of the time. Dots on the dashed line mean the model is honest. Bigger dots mean more matches.</p>
      <figure class="panel chart">
        <svg viewBox={`0 0 ${S + ML + MR} ${S + MT + MB}`} role="img" aria-label="Chart of predicted chance against how often it happened" >
          {ticks.map((p) => (
            <>
              <line x1={x(0)} x2={x(1)} y1={y(p)} y2={y(p)} class="grid" />
              <line y1={y(0)} y2={y(1)} x1={x(p)} x2={x(p)} class="grid" />
              <text x={x(0) - 8} y={y(p) + 4} text-anchor="end" class="tick">{Math.round(p * 100)}%</text>
              <text x={x(p)} y={y(0) + 18} text-anchor="middle" class="tick">{Math.round(p * 100)}%</text>
            </>
          ))}
          <line x1={x(0)} y1={y(0)} x2={x(1)} y2={y(1)} class="diag" />
          {cal.map((c) => (
            <circle cx={x(c.predicted)} cy={y(c.observed)} r={5 + 9 * Math.sqrt(c.n / maxN)} class="dot">
              <title>Said {pct(c.predicted)}, happened {pct(c.observed)} ({c.n} cases)</title>
            </circle>
          ))}
          <text x={x(0.5)} y={S + MT + MB - 6} text-anchor="middle" class="axis">What the model said</text>
          <text x="12" y={y(0.5)} text-anchor="middle" class="axis" transform={`rotate(-90 12 ${y(0.5)})`}>How often it happened</text>
        </svg>
        <details>
          <summary>See the numbers</summary>
          <table>
            <thead><tr><th>Said</th><th>Happened</th><th>Cases</th></tr></thead>
            <tbody>{cal.map((c) => <tr><td>{pct(c.predicted)}</td><td>{pct(c.observed)}</td><td>{c.n}</td></tr>)}</tbody>
          </table>
        </details>
      </figure>

      {leagues.length > 0 && (
        <>
          <h2>By league</h2>
          <div class="panel">
            <ul class="lg">
              {leagues.map(([l, m]) => (
                <li>
                  <div class="top"><span>{leagueName(l)}</span><span><b>{pct(m.accuracy)}</b> right <span class="n">({m.n} matches, log loss {f(m.log_loss)})</span></span></div>
                  <div class="track" aria-hidden="true"><span style={`width:${Math.round(m.accuracy * 100)}%`}></span></div>
                </li>
              ))}
            </ul>
          </div>
        </>
      )}
    </>}

  {bench && (
    <section class="panel glow bm" aria-labelledby="bm-title" data-benchmark>
      <h2 id="bm-title">How do we compare with the bookmakers?</h2>
      <p class="sub">On {bench.n} matches from {benchLabel}. We compared against the bookmakers' closing odds with their margin removed. We never use odds in our predictions.</p>
      {rows.map((r) => (
        <div class="cmp">
          <p class="cmp-head"><b>{r.name}</b> <span class="n">{r.note}</span></p>
          <div class="pair"><span class="who">Our model</span><div class="track" aria-hidden="true"><span class="us" style={`width:${Math.round(r.width(r.m) * 100)}%`}></span></div><b>{r.show(r.m)}</b></div>
          <div class="pair"><span class="who">Bookmakers</span><div class="track" aria-hidden="true"><span class="them" style={`width:${Math.round(r.width(r.b) * 100)}%`}></span></div><b>{r.show(r.b)}</b></div>
        </div>
      ))}
      <p class="verdict">{verdictText(gap)}</p>
    </section>
  )}

  <h2>Back-test on past seasons</h2>
  <p>Before going live, the model was tested the way it is used: predicting each match using only earlier matches. On 5,330 matches from the three seasons before 2025-26 it picked the right result 53% of the time, against 44% for always picking the home team. Football keeps most models in the 50 to 55% range. These live results are the stricter test, and this page will fill in as matches finish.</p>
</Base>
<script>
  import { accuracyByTier } from "../lib/filters.mjs";
  import { pct } from "../lib/format.mjs";

  const box = document.querySelector("[data-confidence]");
  if (box) {
    let picks = [];
    try { picks = JSON.parse(document.getElementById("picks-data").textContent); } catch (e) {}
    let tier = "all", league = "";
    const paint = () => {
      const tally = accuracyByTier(picks, league || null);
      const cur = tally[tier];
      const text = (id, v) => { document.getElementById(id).textContent = v; };
      text("conf-pct", cur.accuracy == null ? "n/a" : pct(cur.accuracy));
      text("conf-of", cur.n ? `right: ${cur.right} of ${cur.n} picks` : "no picks in this group yet");
      document.getElementById("conf-bar").style.width = `${Math.round((cur.accuracy ?? 0) * 100)}%`;
      text("conf-said", cur.n ? `The model gave these picks ${pct(cur.said)} on average.` : "");
      document.getElementById("conf-small").hidden = !(cur.n > 0 && cur.n < 30);
      for (const row of box.querySelectorAll("tr[data-row]")) {
        const t = tally[row.dataset.row];
        row.querySelector("[data-n]").textContent = String(t.n);
        row.querySelector("[data-acc]").textContent = t.accuracy == null ? "n/a" : pct(t.accuracy);
      }
      box.querySelectorAll("[data-tier]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tier === tier)));
      box.querySelectorAll("[data-lg]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.lg === league)));
    };
    box.querySelectorAll("[data-tier]").forEach((b) => b.addEventListener("click", () => { tier = b.dataset.tier; paint(); }));
    box.querySelectorAll("[data-lg]").forEach((b) => b.addEventListener("click", () => { league = b.dataset.lg; paint(); }));
    paint();
  }
</script>
<style>
  .conf { margin: 0 0 28px; max-width: 40rem; display: grid; gap: 12px; }
  .conf h2 { margin: 0; }
  .conf .sub { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .group { display: grid; gap: 6px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--edge); background: var(--surface);
    color: var(--ink); font: inherit; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: background .15s, border-color .15s; }
  .chip:hover { border-color: var(--brand); }
  .chip[aria-pressed="true"] { background: var(--home); border-color: var(--home); color: var(--on-home); }
  .chip .hint { font-weight: 500; opacity: .8; font-size: .85rem; }
  .result { display: grid; gap: 6px; padding-top: 6px; border-top: 1px solid var(--rule); }
  .big { margin: 0; max-width: none; display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; }
  .big b { font-size: 2.4rem; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--brand); }
  .note { margin: 0; color: var(--muted); font-size: 0.9rem; max-width: none; }
  .tiers { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .tiers th, .tiers td { text-align: left; padding: 6px 4px; border-top: 1px solid var(--rule); }
  .tiers .hint { color: var(--muted); font-size: .85rem; }
  @media (max-width: 640px) {
    .chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 -18px; padding: 2px 18px 6px; scrollbar-width: none; }
    .chip { flex: none; white-space: nowrap; }
  }

  .bm { margin: 28px 0 0; max-width: 40rem; }
  .bm h2 { margin: 0 0 4px; }
  .bm .sub { margin: 0 0 12px; color: var(--muted); font-size: 0.95rem; }
  .cmp { margin: 14px 0; }
  .cmp-head { margin: 0 0 4px; max-width: none; }
  .pair { display: grid; grid-template-columns: 6.5rem 1fr 3.6rem; gap: 10px; align-items: center; font-variant-numeric: tabular-nums; margin: 4px 0; }
  .pair .who { font-size: 0.9rem; color: var(--muted); font-weight: 600; }
  .pair b { text-align: right; }
  .track .us { background: var(--home); } .track .them { background: var(--away); }
  .verdict { margin: 12px 0 0; color: var(--muted); font-size: 0.95rem; }
  .empty { max-width: 40rem; }
  .empty h2 { margin-top: 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 12px; }
  .tile { display: grid; gap: 4px; align-content: start; }
  .k { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .tile b { font-size: 2.2rem; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--brand); }
  .d { color: var(--muted); font-size: 0.9rem; }
  .chart { margin: 0; max-width: 34rem; }
  .chart svg { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--rule); stroke-width: 1; }
  .diag { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 5 5; }
  .dot { fill: var(--home); fill-opacity: 0.85; stroke: var(--surface); stroke-width: 2; }
  .tick { fill: var(--muted); font-size: 11px; }
  .axis { fill: var(--ink); font-size: 12px; font-weight: 600; }
  details summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 600; color: var(--brand); }
  .lg { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .lg li { max-width: none; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; font-weight: 600; margin-bottom: 4px; }
  .n { color: var(--muted); font-weight: 400; font-size: 0.88rem; }
  .track { height: 10px; border-radius: 999px; background: var(--rule); overflow: hidden; }
  .track span { display: block; height: 100%; background: var(--home); }
</style>
